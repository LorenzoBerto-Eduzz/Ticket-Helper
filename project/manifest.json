{
  "manifest_version": 3,
  "name": "Ticket Helper",
  "version": "2.0.2",
  "description": "Extracts ticket data and automates BackOffice search",

  "permissions": [
    "tabs",
    "scripting",
    "storage",
    "commands",
    "downloads",
    "offscreen",
    "clipboardWrite"
  ],

  "host_permissions": [
    "*://*.hubspot.com/*",
    "*://conversas.hyperflow.global/*",
    "*://bo.eduzz.com/*",
    "*://bo2.eduzz.com/*",
    "https://api.github.com/*",
    "https://github.com/*",
    "https://objects.githubusercontent.com/*",
    "https://*.githubusercontent.com/*"
  ],

  "background": {
    "service_worker": "background.js"
  },

  "content_scripts": [
    {
      "matches": [
        "*://*.hubspot.com/*"
      ],
      "css": ["hubspot_order.css"],
      "js": ["popup_ui.js", "content.js"],
      "run_at": "document_start"
    },
    {
      "matches": [
        "*://conversas.hyperflow.global/*",
        "*://bo.eduzz.com/*"
      ],
      "js": ["popup_ui.js", "content.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["*://bo.eduzz.com/*"],
      "css": ["faturas_age_badge.css"],
      "js": ["faturas_age_badge.js"],
      "run_at": "document_idle"
    }
  ],

  "commands": {
    "_execute_action": {
      "description": "Activate the extension"
    },
    "02-copy-id": {
      "description": "Copiar ID"
    },
    "03-copy-name": {
      "description": "Copiar Nome"
    },
    "04-copy-email": {
      "description": "Copiar Email"
    },
    "05-copy-doc": {
      "description": "Copiar Doc."
    },
    "06-copy-bo1-masked-emails": {
      "description": "Copiar Emails Censurados / Atribuir BO"
    },
    "07-orbita-search": {
      "description": "Pesquisar Contas Orbita"
    },
    "08-nutror-search": {
      "description": "Pesquisar Contas Nutror"
    },
    "09-faturas-search": {
      "description": "Pesquisar Faturas"
    },
    "10-contratos-search": {
      "description": "Pesquisar Contratos"
    }
  },

  "action": {
    "default_title": "Ativar / Desativar TicketHelper",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },

  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },

  "options_page": "options.html"
}
